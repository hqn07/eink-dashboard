node_modules/
.env
.env.*
!.env.example
.DS_Store
# Runtime state written into DATA_DIR. Ignore the directory's contents
# wholesale rather than naming files: the previous list was per-file, and a
# store added later (secrets.json, webhooks.json, battery-history.json) was
# committable until someone remembered to extend it. data-defaults/ holds the
# seed config that IS tracked.
data/*
!data/.gitkeep
*.log
.cache/
.vscode/
.idea/

# Secrets / keys — never commit
*.pem
*.key
credentials.json
service-account*.json

# Per-device firmware secrets
esp32/secrets.h
esp32/weather_station/secrets.h
esp32/weather_station_b/secrets.h

# Vite build output for the React control app (built on deploy)
public/control-app/
.claude/

# visual-regression diff output (baseline PNG is committed; diff is not)
test/visual-baseline/*.diff.png
# check-visual writes the failing render here for eyeballing — scratch, not a
# baseline. It got committed once (73e07e5) because `git add -A` ran while a
# failure was on disk.
test/visual/current.png

# one-off component preview (scripts/preview-components.mjs)
test/_component-preview.png
test/_component-preview-1bit.png

# Arduino CLI build output
esp32/*/build/
