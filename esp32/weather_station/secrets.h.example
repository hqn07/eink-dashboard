// secrets.h.example — copy to secrets.h (gitignored) and fill in.
// Never commit secrets.h.
#pragma once

// As of firmware 1.8.0 the BW sketch provisions WiFi via a captive
// portal (AP name: "eink-setup"). These two strings stay in the
// schema for build-time compatibility but are NOT read by the BW
// firmware — leave them blank, or fill them and they'll just be
// ignored. The b (3-color) sketch still uses them.
const char* ssid        = "";
const char* password    = "";

// Hybrid server URLs. The firmware probes the LAN URL first (3 s
// timeout). If it can't reach it — Mac asleep, off-network, etc. —
// it falls back to the cloud URL automatically. Set either to "" to
// disable that branch (LAN-only or cloud-only).
//
//   serverBaseLan:    Mac running `npm start` on the local network.
//     Use `http://<mac-ip>:3000` or mDNS `http://eink-server.local:3000`.
//   serverBaseCloud:  Railway / Render / Fly deployment URL.
const char* serverBaseLan   = "http://eink-server.local:3000";
const char* serverBaseCloud = "https://your-app.up.railway.app";

// Optional shared secret. Must match DEVICE_TOKEN env var on the server.
const char* deviceToken = "";
