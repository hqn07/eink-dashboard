{
  "name": "eink-dashboard",
  "version": "1.0.0",
  "description": "Server-rendered dashboard for ESP32 e-ink display",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "mac-agent": "node mac-agent.js",
    "control-dev": "vite",
    "build": "vite build",
    "build:css": "node scripts/build-face-css.mjs",
    "prebuild": "npm run build:css && npm run lint:eink && npm run check:widgets",
    "prestart": "npm run build:css",
    "predev": "npm run build:css",
    "lint:eink": "node scripts/eink-lint.mjs",
    "check:css": "node scripts/build-face-css.mjs --check",
    "check:widgets": "node scripts/check-widgets.mjs",
    "check": "npm run check:css && npm run check:widgets && npm run lint:eink",
    "test:visual": "node scripts/visual-regression.mjs",
    "test:visual:update": "node scripts/visual-regression.mjs --update",
    "test:api": "node --test test/endpoints.test.mjs test/firstrun.test.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-switch": "^1.2.6",
    "compression": "^1.8.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "fast-xml-parser": "^5.8.0",
    "framer-motion": "^11.11.10",
    "gtfs-realtime-bindings": "^2.1.0",
    "node-ical": "^0.26.1",
    "puppeteer": "^23.5.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^1.5.0",
    "react-loading-skeleton": "^3.5.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "vite": "^5.4.10"
  }
}
