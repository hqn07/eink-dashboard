# Weather is provided by Open-Meteo — no API key required.
# (https://open-meteo.com)

# Default city (used until you pick one via the control panel)
CITY=Gainesville,FL,US

# Server port (Railway will override this)
PORT=3000

# Where mutable state (config.json, battery.json, devices.json,
# battery-history.json) is written. Defaults to ./data locally.
# On Railway: attach a persistent Volume and set this to its mount
# path (e.g. /data) so config survives redeploys. Seed defaults live
# in data-defaults/ and are NOT shadowed by the volume.
DATA_DIR=

# Background pre-render: proactively re-renders the active screen on an
# interval. OFF by default — stale-while-revalidate already serves the device
# from cache and refreshes on wake, so on-demand is enough, and an always-on
# interval render keeps Chromium resident 24/7 (cloud RAM cost) for renders
# nobody reads. Turn on ONLY for a shared host with many frequently-waking
# devices. Cadence in ms (default 300000 = 5 min, floor 60000).
# PRERENDER=1
# PRERENDER_INTERVAL_MS=300000

# Idle browser close: Chromium holds ~300-500 MB resident. After this many ms
# with no active render the browser closes; getBrowser() relaunches it on the
# next render (+1-2s cold start, invisible to an e-ink device — the image
# cache keeps serving instantly meanwhile). Big cloud RAM saving on an
# infrequently-woken fleet.
# DEFAULT 0 (stay resident). The relaunch churn leaked orphaned
# chrome_crashpad_handler zombies and exhausted the container PID table
# (fork: EAGAIN -> fleet-down, Aug 2026). Safe to re-enable now that `tini`
# (nixpacks) reaps zombies + crash-reporter is disabled: set a quiet-window ms.
# BROWSER_IDLE_MS=90000

# Push now: opens a fast-refresh window. The device's next wake is told to
# poll every PUSH_INTERVAL_SECONDS (floor 10) for PUSH_WINDOW_MS (floor
# 30000), then it returns to the normal interval. Sub-minute polling needs
# firmware that reads the X-Refresh-Seconds header; current firmware honors
# the 1-minute floor via X-Refresh-Rate.
PUSH_WINDOW_MS=300000
PUSH_INTERVAL_SECONDS=20

# Battery-aware refresh: on low battery the server raises the refresh
# interval (never shortens below your config) so the cell lasts longer.
# <35% -> >=1h, <20% -> >=2h, <10% -> >=4h. Firmware already honors the
# X-Refresh-Rate header, so no reflash needed. Set BATTERY_AWARE=0 to off.
BATTERY_AWARE=1

# Optional: a shared secret the ESP32 sends so randos can't hit your endpoints
# Leave blank to disable auth
DEVICE_TOKEN=

# Lockout recovery: forgot the control PIN? Set RESET_PIN=1 (or true/yes/on)
# and restart — the server clears the PIN on boot, leaving the editor open so
# you can set a new one. Then turn it OFF: remove the var, or set RESET_PIN=0
# (0/false/no/empty/unset are all off). If left on, every restart re-clears.
# RESET_PIN=0

# B-panel column-offset compensation (hardware quirk of the 3-color panel:
# image displays rotated right by N px, rightmost strip wraps to the left
# edge). Server pre-rotates /display-3c.bin left by N so it lands straight.
# Only affects the 3c binary — BW endpoints and PNG previews untouched.
# Calibrate by photo: strip still on the left → increase; overshoot (left
# content wrapped to the right) → decrease. 0/unset = off.
PANEL_SHIFT_3C_PX=0

# ---- AI widget ----------------------------------------------------------
# PREFER THE UI: Settings > Tools > Connections sets the key, model and
# provider URL without touching env vars. The key is written to
# DATA_DIR/secrets.json, deliberately OUTSIDE config.json so that
# Backup > Export — which serialises the config — cannot contain it.
#
# These env vars remain a fallback for hosts configured before that existed;
# a key saved in the UI takes precedence. Without either, the `ai` widget
# renders SETUP NEEDED and nothing else in the dashboard is affected.
#
# Any OpenAI-compatible /chat/completions endpoint works — the widget speaks
# plain HTTP, so switching providers is an env change, not a code change.
#   OpenAI:   AI_BASE_URL=https://api.openai.com/v1   (the default)
#   DeepSeek: AI_BASE_URL=https://api.deepseek.com/v1 with AI_MODEL=deepseek-flash
#             (deepseek-flash is the cheap one: $0.30/M in, $1.20/M out at
#              peak, halved 01:00-04:00 and 06:00-10:00 UTC Mon-Fri.
#              deepseek-v4-pro is ~4x that and reasons harder.)
#
# AI_MODEL has no default on purpose: a plausible-but-wrong guess fails at
# request time with a provider error that reads like a bug, while a missing
# one names the fix immediately.
#
# Cost/battery note: generation is cadence-based (daily or hourly per tile),
# cached on disk in DATA_DIR, so ordinary panel wakes cost nothing. New text
# means a full colour redraw (15-26s), which is why daily is the default.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# ---- Local dev on Apple Silicon macOS -----------------------------------
# Puppeteer's bundled Chrome download is UNSIGNED, and arm64 macOS refuses to
# execute unsigned binaries — it fails as `spawn Unknown system error -88`
# (EBADARCH), which reads like an architecture mismatch even when node, the
# binary and the machine are all arm64. Ad-hoc codesigning it does not work
# either ("main executable failed strict validation").
#
# Point Puppeteer at a real installed Chrome instead. This fixes both the
# /display.* endpoints locally and the visual-regression harness:
#   PUPPETEER_EXECUTABLE_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
# Railway sets this to the nix chromium path; see nixpacks.toml (inert under
# the Railpack builder, so the real value lives in the Railway dashboard).
PUPPETEER_EXECUTABLE_PATH=
