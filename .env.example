# Weather is provided by Open-Meteo — no API key required.
# (https://open-meteo.com)

# Default city (used until you pick one via the control panel)
CITY=Gainesville,FL,US

# Server port (Railway will override this)
PORT=3000

# Where mutable state (config.json, battery.json, devices.json,
# battery-history.json) is written. Defaults to ./data locally.
# On Railway: attach a persistent Volume and set this to its mount
# path (e.g. /data) so config survives redeploys. Seed defaults live
# in data-defaults/ and are NOT shadowed by the volume.
DATA_DIR=

# Background pre-render: keeps the active screen cached so the ESP32 wake
# never waits on a cold Puppeteer render. On by default (set PRERENDER=0
# to disable). Cadence in ms (default 300000 = 5 min, floor 60000).
PRERENDER=1
PRERENDER_INTERVAL_MS=300000

# Push now: opens a fast-refresh window. The device's next wake is told to
# poll every PUSH_INTERVAL_SECONDS (floor 10) for PUSH_WINDOW_MS (floor
# 30000), then it returns to the normal interval. Sub-minute polling needs
# firmware that reads the X-Refresh-Seconds header; current firmware honors
# the 1-minute floor via X-Refresh-Rate.
PUSH_WINDOW_MS=300000
PUSH_INTERVAL_SECONDS=20

# Battery-aware refresh: on low battery the server raises the refresh
# interval (never shortens below your config) so the cell lasts longer.
# <35% -> >=1h, <20% -> >=2h, <10% -> >=4h. Firmware already honors the
# X-Refresh-Rate header, so no reflash needed. Set BATTERY_AWARE=0 to off.
BATTERY_AWARE=1

# Optional: a shared secret the ESP32 sends so randos can't hit your endpoints
# Leave blank to disable auth
DEVICE_TOKEN=

# Lockout recovery: forgot the control PIN? Set RESET_PIN=1 and restart —
# the server clears the PIN on boot, leaving the editor open so you can set
# a new one. REMOVE this var right after, or every restart re-clears the PIN.
# RESET_PIN=1

# --- Mac-on-cloud (optional) ---
# When the dashboard runs on a non-darwin host (Railway / cloud), the Mac
# widgets need their data pushed to them. Run `npm run mac-agent` on a
# Mac to periodically POST nowplaying + battery to /api/mac-state.
#   CLOUD_URL: the cloud server's public URL (no trailing slash)
#   DEVICE_TOKEN: same as above; agent sends it on every push
#   MAC_AGENT_INTERVAL_MS: push cadence (default 30000)
# Force the server itself to read from the cache instead of spawning
# nowplaying-cli/pmset (useful for local cloud-mode testing):
#   MAC_FROM_CACHE=1
CLOUD_URL=
MAC_AGENT_INTERVAL_MS=30000
